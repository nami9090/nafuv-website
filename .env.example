# ==========================================================================
# NAFUV settings. Copy this file to ".env" (next to manage.py) and fill it.
# NEVER put the real .env in Git.
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ==========================================================================

# --- Security --------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,nafuv.org,www.nafuv.org
CSRF_TRUSTED_ORIGINS=https://nafuv.org,https://www.nafuv.org
SITE_URL=http://127.0.0.1:8000
# Behind Nginx/cPanel proxy in HTTPS: True
USE_X_FORWARDED_PROTO=False

# --- Database: postgresql, mysql (cPanel) or sqlite ------------------------
DB_ENGINE=postgresql
DB_NAME=nafuv_db
DB_USER=nami
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Files (cPanel example: /home/USER/public_html/static/) ----------------
# STATIC_ROOT=
# MEDIA_ROOT=
# Pictures not showing in production with DEBUG=False? Set True
# (only if Apache/Nginx does not already serve the media folder)
SERVE_MEDIA=False

# --- E-mail (contact form, donation receipts) ------------------------------
# Console = e-mails printed in the terminal (development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Real sending, e.g. the info@nafuv.org mailbox of the hosting:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.nafuv.org
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=info@nafuv.org
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NAFUV <info@nafuv.org>
CONTACT_EMAIL=info@nafuv.org

# --- Stripe (online donations) ---------------------------------------------
# Test keys start with sk_test_ ; live keys with sk_live_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DONATION_CURRENCY=usd
